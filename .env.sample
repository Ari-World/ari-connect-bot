DISCORD_API_TOKEN = 
DISCORD_COMMAND_PREFIX = !

# Dev database — run `docker compose up -d` (see docker-compose.yml) to
# start a local Mongo container, then use these values as-is.
MONGO_DB_URL = mongodb://localhost:27017
MONGO_DB_CLUSTER = AriConnectDB

# Optional — Logging IDs. Leave unset to disable Discord-side logging.
# If set, make sure every channel ID below is a channel inside LOG_GUILD_ID.
LOG_GUILD_ID =
LOG_GENENRAL_ID =
LOG_CHAT_ID =
LOG_SYSTEM_ID =
LOG_MOD_ID =
LOG_PLAYER_REPORT_ID =

# Optional — defaults to 1000.
CACHE_THRESHOLD = 1000

# Optional — leave unset to disable.
GENERAL_LOBBY_NAME =

# Optional — defaults to true. Set to false/0 to disable Rich's colored
# console logging (plain log lines instead).
ENABLE_RICH_LOGGING =

# Optional — a trusted bot-to-bot integration (see ari/integrations/).
# Leave unset to disable it entirely.
FENDERBOT_USER_ID =
